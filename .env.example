# CRMate Environment Variables Template
# Copy this file to .env.local for local development, or set these in your deployment platform (Vercel, Render, etc.)

# Supabase (Optional: CRMate runs in offline/local storage mode if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Node Environment
NODE_ENV=production
