# CRMate Environment Variables Template
# Copy this file to .env.local for local development.
# On Netlify, add these under Site Settings > Environment Variables.

# Supabase Configuration (Optional for current local storage phase, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL Configuration
NEXT_PUBLIC_APP_URL=https://crmate.netlify.app
