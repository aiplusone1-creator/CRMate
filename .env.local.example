# ==============================================================================
# CRMate - Supabase & Vercel Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.local.example .env.local
#
# IMPORTANT:
# - Never commit .env.local to GitHub. It is protected in .gitignore.
# - In Vercel, set these identical environment variables under:
#   Project Settings > Environment Variables.
# ==============================================================================

# Supabase Project URL (Found under: Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://ojhscuamypvmzhlgrtkf.supabase.co

# Supabase Anonymous Public Key (Found under: Supabase Dashboard > Project Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Supabase Service Role Secret Key (Found under: Supabase Dashboard > Project Settings > API > Project API keys > service_role secret)
# Required ONLY for initial data migration script: node scripts/import-to-supabase.js --live
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
